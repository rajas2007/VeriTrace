# ============================================================
# VeriTrace Desktop - Environment Template
# ============================================================

# Desktop Environment Mode (development / staging / production)
VERITRACE_ENV=development

# Local Storage Directory
# When blank, automatically resolves to: %LOCALAPPDATA%/VeriTrace/
VERITRACE_DATA_DIR=

# OCR Configuration (Tesseract OCR Engine)
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=

# Execution Isolation Mode
# in_process: Runs forensic pipeline via QThreadPool inside the main desktop app
# out_of_process: Spawns the dedicated investigation_worker background process
VERITRACE_WORKER_MODE=in_process

# Optional Cloud AI (Configurable via LLMProviderProtocol)
# Core extraction, forensics, and cross-matching operate 100% offline with zero API keys.
# Deterministic template fallback is used automatically when key is omitted.
VERITRACE_AI_PROVIDER=groq
VERITRACE_AI_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
