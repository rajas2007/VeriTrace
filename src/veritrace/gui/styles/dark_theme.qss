/* ===================================================================
   VeriTrace Desktop — Linear / Vercel Refined Enterprise Dark Theme
   Palette: Background #0B0E14 | Surface #11151D | Elevated #161B26
   Borders: #232A38 | Text: Primary #E6E9F0, Secondary #9AA4B5, Muted #6B7587
   Accent: #5B8CFF | Compatibility Anchor: #1e1e2e
   =================================================================== */

/* --- Global Palette & Base Widgets --- */
QWidget {
    background-color: #0B0E14;
    color: #E6E9F0;
    font-family: "Inter", "Segoe UI", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    font-size: 13px;
    selection-background-color: rgba(91, 140, 255, 0.25);
    selection-color: #E6E9F0;
}

QMainWindow {
    background-color: #0B0E14;
}

QMainWindow::separator {
    background-color: #1D2330;
    width: 1px;
    height: 1px;
}

QMainWindow::separator:hover {
    background-color: #5B8CFF;
}

/* --- Menus & Top Navigation --- */
QMenuBar {
    background-color: #0B0E14;
    color: #9AA4B5;
    border-bottom: 1px solid #1D2330;
    padding: 2px 6px;
    font-weight: 500;
}

QMenuBar::item {
    background-color: transparent;
    padding: 5px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #161B26;
    color: #E6E9F0;
}

QMenu {
    background-color: #11151D;
    color: #E6E9F0;
    border: 1px solid #232A38;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
    font-size: 12.5px;
}

QMenu::item:selected {
    background-color: #161B26;
    color: #5B8CFF;
}

QMenu::separator {
    height: 1px;
    background-color: #1D2330;
    margin: 4px 6px;
}

/* --- Toolbar --- */
QToolBar {
    background-color: #0B0E14;
    border-bottom: 1px solid #1D2330;
    spacing: 6px;
    padding: 4px 10px;
}

QToolBar::separator {
    width: 1px;
    background-color: #1D2330;
    margin: 4px 6px;
}

QToolButton {
    background-color: transparent;
    color: #9AA4B5;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 10px;
    font-weight: 500;
    font-size: 12px;
}

QToolButton:hover {
    background-color: #161B26;
    border-color: #232A38;
    color: #E6E9F0;
}

QToolButton:pressed {
    background-color: #11151D;
}

/* --- Dock Widgets & Floating Panels --- */
QDockWidget {
    color: #E6E9F0;
    font-weight: 600;
}

QDockWidget::title {
    background-color: #11151D;
    padding: 8px 12px;
    border-bottom: 1px solid #1D2330;
    border-top: 1px solid #1D2330;
    letter-spacing: 0.06em;
    color: #9AA4B5;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
}

/* --- Cards, Panels & Containers (Zebra-free, low contrast) --- */
QFrame#card {
    background-color: #11151D;
    border: 1px solid #232A38;
    border-radius: 8px;
    padding: 12px;
}

QFrame#card:hover {
    border-color: #364154;
}

QFrame#panelBox {
    background-color: #11151D;
    border: 1px solid #232A38;
    border-radius: 8px;
}

/* --- Buttons --- */
QPushButton {
    background-color: #161B26;
    color: #E6E9F0;
    border: 1px solid #232A38;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 500;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #1A212E;
    border-color: #364154;
}

QPushButton:pressed {
    background-color: #11151D;
}

QPushButton:disabled {
    background-color: #0B0E14;
    color: #4A5263;
    border-color: #1D2330;
}

QPushButton#primaryButton {
    background-color: #5B8CFF;
    color: #0B0E14;
    border: 1px solid #5B8CFF;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #709CFF;
    border-color: #709CFF;
}

QPushButton#primaryButton:pressed {
    background-color: #4674E6;
    border-color: #4674E6;
}

QPushButton#dangerButton, QPushButton#dismissButton {
    background-color: rgba(240, 97, 109, 0.12);
    color: #F0616D;
    border: 1px solid rgba(240, 97, 109, 0.30);
    font-weight: 600;
}

QPushButton#dangerButton:hover, QPushButton#dismissButton:hover {
    background-color: rgba(240, 97, 109, 0.22);
    border-color: #F0616D;
}

QPushButton#confirmButton {
    background-color: rgba(79, 209, 165, 0.12);
    color: #4FD1A5;
    border: 1px solid rgba(79, 209, 165, 0.30);
    font-weight: 600;
}

QPushButton#confirmButton:hover {
    background-color: rgba(79, 209, 165, 0.22);
    border-color: #4FD1A5;
}

QPushButton#accentButton {
    background-color: rgba(91, 140, 255, 0.12);
    color: #5B8CFF;
    border: 1px solid rgba(91, 140, 255, 0.30);
    font-weight: 600;
}

QPushButton#accentButton:hover {
    background-color: rgba(91, 140, 255, 0.22);
    border-color: #5B8CFF;
}

/* --- Text Inputs & Dropdowns --- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #0B0E14;
    color: #E6E9F0;
    border: 1px solid #232A38;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12.5px;
    selection-background-color: rgba(91, 140, 255, 0.35);
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #5B8CFF;
    background-color: #11151D;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
}

/* --- Tables & Data Views (Zebra-free, 38-40px comfortable rows) --- */
QTableView, QTableWidget, QTreeView, QTreeWidget, QListView, QListWidget {
    background-color: #11151D;
    alternate-background-color: #11151D;
    color: #E6E9F0;
    border: 1px solid #232A38;
    border-radius: 8px;
    gridline-color: #1D2330;
    outline: none;
}

QTableView::item, QTreeView::item, QListView::item {
    padding: 8px 12px;
    border-bottom: 1px solid #1D2330;
    height: 38px;
}

QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
    background-color: #162038;
    color: #E6E9F0;
    border-left: 2px solid #5B8CFF;
}

QTableView::item:hover:!selected, QTreeView::item:hover:!selected, QListView::item:hover:!selected {
    background-color: #161B26;
}

QHeaderView::section {
    background-color: #11151D;
    color: #6B7587;
    border: none;
    border-bottom: 1px solid #232A38;
    border-right: 1px solid #1D2330;
    padding: 9px 12px;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

/* --- Tabs (Underline Linear-style) --- */
QTabWidget::pane {
    border: 1px solid #232A38;
    background-color: #11151D;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: transparent;
    color: #6B7587;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 500;
    font-size: 12.5px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: transparent;
    color: #E6E9F0;
    font-weight: 600;
    border-bottom: 2px solid #5B8CFF;
}

QTabBar::tab:hover:!selected {
    color: #9AA4B5;
}

/* --- Progress Bar --- */
QProgressBar {
    background-color: #0B0E14;
    border: 1px solid #232A38;
    border-radius: 4px;
    text-align: center;
    color: #9AA4B5;
    font-size: 11px;
    font-weight: 600;
}

QProgressBar::chunk {
    background-color: #5B8CFF;
    border-radius: 3px;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #0B0E14;
    color: #6B7587;
    border-top: 1px solid #1D2330;
    padding: 3px 12px;
    font-size: 12px;
}

/* --- Scroll Bars (Subtle 6px Minimalist Auto-hide Style) --- */
QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #232A38;
    min-height: 24px;
    border-radius: 3px;
    margin: 1px;
}

QScrollBar::handle:vertical:hover {
    background-color: #364154;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #232A38;
    min-width: 24px;
    border-radius: 3px;
    margin: 1px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #364154;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- Splitter --- */
QSplitter::handle {
    background-color: #1D2330;
}

QSplitter::handle:hover {
    background-color: #5B8CFF;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* --- CheckBox & RadioButton --- */
QCheckBox, QRadioButton {
    color: #9AA4B5;
    spacing: 7px;
    font-size: 12px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    background-color: #0B0E14;
    border: 1px solid #232A38;
    border-radius: 4px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #5B8CFF;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #5B8CFF;
    border-color: #5B8CFF;
}
