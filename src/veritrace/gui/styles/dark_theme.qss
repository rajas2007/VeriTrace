/* ===================================================================
   VeriTrace Desktop — Cyber-Forensic Intelligence Workstation (QSS)
   Optimized for High-DPI displays, multi-pane docking, and long review sessions.
   Theme: Deep Obsidian & Cyan Matrix Palette (#090d14 / #1e1e2e palette)
   =================================================================== */

/* --- Global Palette & Base Widgets --- */
QWidget {
    background-color: #090d14;
    color: #f1f5f9;
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", "Helvetica Neue", sans-serif;
    font-size: 13px;
    selection-background-color: #1d4ed8;
    selection-color: #ffffff;
}

QMainWindow {
    background-color: #06090f;
}

QMainWindow::separator {
    background-color: #1c2438;
    width: 3px;
    height: 3px;
}

QMainWindow::separator:hover {
    background-color: #38bdf8;
}

/* --- Menus & Toolbars --- */
QMenuBar {
    background-color: #090d14;
    color: #94a3b8;
    border-bottom: 1px solid #1c2438;
    padding: 4px 8px;
    font-weight: 500;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background-color: #111726;
    color: #38bdf8;
}

QMenu {
    background-color: #0f1420;
    color: #f1f5f9;
    border: 1px solid #1c2438;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 28px 7px 14px;
    border-radius: 5px;
}

QMenu::item:selected {
    background-color: #1d4ed8;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #1c2438;
    margin: 5px 8px;
}

QToolBar {
    background-color: #090d14;
    border-bottom: 1px solid #1c2438;
    spacing: 5px;
    padding: 3px 6px;
}

QToolBar::separator {
    width: 1px;
    background-color: #1c2438;
    margin: 3px 6px;
}

QToolButton {
    background-color: #0f1420;
    color: #cbd5e1;
    border: 1px solid #1c2438;
    border-radius: 5px;
    padding: 4px 9px;
    font-weight: 500;
    font-size: 11.5px;
}

QToolButton:hover {
    background-color: #161e30;
    border-color: #38bdf8;
    color: #ffffff;
}

QToolButton:pressed {
    background-color: #06090f;
}

/* --- Panels, Docks & Frames --- */
QDockWidget {
    color: #f1f5f9;
    font-weight: 600;
}

QDockWidget::title {
    background-color: #0f1420;
    padding: 8px 14px;
    border-bottom: 1px solid #1c2438;
    border-top: 1px solid #1c2438;
    letter-spacing: 0.6px;
    color: #38bdf8;
    font-size: 11px;
    font-weight: 700;
}

QFrame#card {
    background-color: #0f1420;
    border: 1px solid #1c2438;
    border-radius: 8px;
    padding: 12px;
}

QFrame#card:hover {
    border-color: #2563eb;
}

QFrame#panelBox {
    background-color: #0f1420;
    border: 1px solid #1c2438;
    border-radius: 6px;
}

/* --- Buttons --- */
QPushButton {
    background-color: #141c2c;
    color: #cbd5e1;
    border: 1px solid #1c2438;
    border-radius: 6px;
    padding: 7px 15px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #1a243a;
    border-color: #38bdf8;
    color: #f1f5f9;
}

QPushButton:pressed {
    background-color: #0a0e18;
}

QPushButton:disabled {
    background-color: #090d14;
    color: #475569;
    border-color: #161e30;
}

QPushButton#primaryButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1d4ed8, stop:1 #0284c7);
    color: #ffffff;
    border: 1px solid #38bdf8;
    font-weight: 700;
}

QPushButton#primaryButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563eb, stop:1 #0ea5e9);
    border-color: #7dd3fc;
}

QPushButton#dangerButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #b91c1c, stop:1 #ef4444);
    color: #ffffff;
    border: 1px solid #f87171;
    font-weight: 700;
}

QPushButton#dangerButton:hover {
    background-color: #ef4444;
}

QPushButton#confirmButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #059669, stop:1 #10b981);
    color: #ffffff;
    border: 1px solid #34d399;
    font-weight: 700;
}

QPushButton#confirmButton:hover {
    background-color: #10b981;
    border-color: #6ee7b7;
}

QPushButton#dismissButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #991b1b, stop:1 #dc2626);
    color: #ffffff;
    border: 1px solid #ef4444;
    font-weight: 700;
}

QPushButton#dismissButton:hover {
    background-color: #ef4444;
}

QPushButton#accentButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6d28d9, stop:1 #8b5cf6);
    color: #ffffff;
    border: 1px solid #a78bfa;
    font-weight: 700;
}

QPushButton#accentButton:hover {
    background-color: #8b5cf6;
}

/* --- Text Inputs & Entry Fields --- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #06090f;
    color: #f1f5f9;
    border: 1px solid #1c2438;
    border-radius: 6px;
    padding: 7px 11px;
    selection-background-color: #1d4ed8;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #38bdf8;
    background-color: #090d14;
}

/* --- Tables & Item Views --- */
QTableView, QTableWidget, QTreeView, QTreeWidget, QListView, QListWidget {
    background-color: #090d14;
    alternate-background-color: #0e1320;
    color: #f1f5f9;
    border: 1px solid #1c2438;
    border-radius: 6px;
    gridline-color: #161e30;
    outline: none;
}

QTableView::item, QTreeView::item, QListView::item {
    padding: 6px 8px;
    border-bottom: 1px solid #111726;
}

QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
    background-color: #172554;
    color: #38bdf8;
    border-left: 3px solid #38bdf8;
}

QTableView::item:hover, QTreeView::item:hover, QListView::item:hover {
    background-color: #161e30;
}

QHeaderView::section {
    background-color: #0f1420;
    color: #94a3b8;
    border: none;
    border-bottom: 2px solid #1c2438;
    border-right: 1px solid #161e30;
    padding: 8px 11px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.6px;
}

/* --- Tabs --- */
QTabWidget::pane {
    border: 1px solid #1c2438;
    background-color: #090d14;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #0f1420;
    color: #94a3b8;
    padding: 7px 15px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border: 1px solid transparent;
    font-weight: 600;
    font-size: 11.5px;
}

QTabBar::tab:selected {
    background-color: #090d14;
    color: #38bdf8;
    border: 1px solid #1c2438;
    border-bottom: 2px solid #38bdf8;
}

QTabBar::tab:hover:!selected {
    color: #f1f5f9;
    background-color: #161e30;
}

/* --- Progress Bar --- */
QProgressBar {
    background-color: #0f1420;
    border: 1px solid #1c2438;
    border-radius: 5px;
    text-align: center;
    color: #f1f5f9;
    font-size: 11px;
    font-weight: 700;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1d4ed8, stop:1 #06b6d4);
    border-radius: 4px;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #06090f;
    color: #94a3b8;
    border-top: 1px solid #1c2438;
    padding: 4px 12px;
    font-size: 12px;
}

/* --- Scroll Bars --- */
QScrollBar:vertical {
    background-color: #090d14;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #1e293b;
    min-height: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #334155;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #090d14;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #1e293b;
    min-width: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #334155;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- Splitter --- */
QSplitter::handle {
    background-color: #161e30;
}

QSplitter::handle:hover {
    background-color: #38bdf8;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

/* --- CheckBox & RadioButton --- */
QCheckBox, QRadioButton {
    color: #cbd5e1;
    spacing: 7px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 17px;
    height: 17px;
    background-color: #06090f;
    border: 1px solid #1c2438;
    border-radius: 4px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #38bdf8;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #1d4ed8;
    border-color: #38bdf8;
}
