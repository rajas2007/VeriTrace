/* ===================================================================
   VeriTrace Desktop - Forensic Workstation Dark Theme (QSS)
   Optimized for High-DPI screens, multi-pane docking, and long review sessions.
   =================================================================== */

/* --- Global Palette & Base Widgets --- */
QWidget {
    background-color: #1e1e2e;
    color: #e2e8f0;
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    font-size: 13px;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}

QMainWindow {
    background-color: #181825;
}

QMainWindow::separator {
    background-color: #313244;
    width: 3px;
    height: 3px;
}

QMainWindow::separator:hover {
    background-color: #4e80ee;
}

/* --- Menus & Toolbars --- */
QMenuBar {
    background-color: #181825;
    color: #cdd6f4;
    border-bottom: 1px solid #313244;
    padding: 2px 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #313244;
}

QMenu {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #3b82f6;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #313244;
    margin: 4px 6px;
}

QToolBar {
    background-color: #181825;
    border-bottom: 1px solid #313244;
    spacing: 6px;
    padding: 4px 8px;
}

/* --- Panels, Docks & Frames --- */
QDockWidget {
    titlebar-close-icon: url("");
    titlebar-normal-icon: url("");
    color: #cdd6f4;
    font-weight: 600;
}

QDockWidget::title {
    background-color: #181825;
    padding: 6px 10px;
    border-bottom: 1px solid #313244;
}

QFrame#card {
    background-color: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 12px;
}

/* --- Buttons --- */
QPushButton {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 5px;
    padding: 6px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #45475a;
    border-color: #585b70;
}

QPushButton:pressed {
    background-color: #272838;
}

QPushButton:disabled {
    background-color: #181825;
    color: #6c7086;
    border-color: #272838;
}

QPushButton#primaryButton {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #1d4ed8;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #1d4ed8;
}

QPushButton#dangerButton {
    background-color: #dc2626;
    color: #ffffff;
    border: 1px solid #b91c1c;
    font-weight: 600;
}

QPushButton#dangerButton:hover {
    background-color: #b91c1c;
}

QPushButton#confirmButton {
    background-color: #16a34a;
    color: #ffffff;
    border: 1px solid #15803d;
    font-weight: 600;
}

QPushButton#confirmButton:hover {
    background-color: #15803d;
}

QPushButton#dismissButton {
    background-color: #dc2626;
    color: #ffffff;
    border: 1px solid #b91c1c;
    font-weight: 600;
}

QPushButton#dismissButton:hover {
    background-color: #b91c1c;
}

/* --- Text Inputs & Entry Fields --- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #11111b;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 5px;
    padding: 5px 8px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #3b82f6;
}

/* --- Tables & Item Views --- */
QTableView, QTableWidget, QTreeView, QTreeWidget, QListView, QListWidget {
    background-color: #181825;
    alternate-background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    gridline-color: #313244;
    outline: none;
}

QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
    background-color: #2a3a5c;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #1e1e2e;
    color: #a6adc8;
    border: none;
    border-bottom: 1px solid #313244;
    border-right: 1px solid #313244;
    padding: 6px 10px;
    font-weight: 600;
    font-size: 12px;
}

/* --- Tabs --- */
QTabWidget::pane {
    border: 1px solid #313244;
    background-color: #181825;
    border-radius: 5px;
}

QTabBar::tab {
    background-color: #181825;
    color: #9399b2;
    padding: 7px 16px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border: 1px solid transparent;
}

QTabBar::tab:selected {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-bottom: 1px solid #1e1e2e;
}

QTabBar::tab:hover:!selected {
    color: #cdd6f4;
    background-color: #252538;
}

/* --- Progress Bar --- */
QProgressBar {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 4px;
    text-align: center;
    color: #cdd6f4;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #3b82f6;
    border-radius: 3px;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #11111b;
    color: #a6adc8;
    border-top: 1px solid #313244;
    padding: 2px 8px;
    font-size: 12px;
}

/* --- Scroll Bars --- */
QScrollBar:vertical {
    background-color: #181825;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #45475a;
    min-height: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #585b70;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #181825;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #45475a;
    min-width: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #585b70;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- Splitter --- */
QSplitter::handle {
    background-color: #313244;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}
